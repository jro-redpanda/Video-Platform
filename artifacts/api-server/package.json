{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "g0:smoke": "pnpm run build && node --enable-source-maps ./dist/g0-runtime-smoke.mjs",
    "queue:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/queue-smoke.mjs",
    "provider:smoke": "node ../../scripts/src/run-smoke.mjs external-provider ./scripts/provider-smoke.mjs --skip-build",
    "upload:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/upload-step9-smoke.mjs",
    "webhook:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/webhook-step10-smoke.mjs",
    "embed:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/embed-step11-smoke.mjs",
    "playback-security:smoke": "NODE_ENV=test node --experimental-strip-types ./src/playback-source-security-smoke.ts",
    "library:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/video-library-step12-smoke.mjs",
    "folders:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/folders-step13-smoke.mjs",
    "bulk-video:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/bulk-video-step14-smoke.mjs",
    "thumbnail:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/thumbnail-step15-smoke.mjs",
    "thumbnail:storage-smoke": "node ../../scripts/src/run-smoke.mjs storage ./dist/thumbnail-storage-roundtrip-smoke.mjs",
    "thumbnail:cleanup-once": "pnpm run build && node ./dist/thumbnail-cleanup-once.mjs",
    "billing:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/billing-step18-smoke.mjs",
    "analytics:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/analytics-smoke.mjs",
    "audit:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/audit-smoke.mjs",
    "onboarding:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/onboarding-smoke.mjs",
    "custom-domain:smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/custom-domain-smoke.mjs",
    "cold-master:smoke": "node ../../scripts/src/run-smoke.mjs local ./dist/cold-master-storage-smoke.mjs",
    "master-storage:lifecycle-smoke": "node ../../scripts/src/run-smoke.mjs database ./dist/master-storage-lifecycle-smoke.mjs",
    "g1:smoke": "NODE_ENV=test pnpm run build && NODE_ENV=test node ./dist/g1-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/providers": "workspace:*",
    "better-auth": "^1.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "pg-boss": "^12.29.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^22.6.0",
    "stripe-replit-sync": "^1.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
